{
  "name": "arkham-companion",
  "version": "1.8.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @arkham/web dev",
    "build": "pnpm --filter @arkham/web build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "pnpm --filter @arkham/web e2e",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p .claude/hooks",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "carddata:fetch": "pnpm --filter @arkham/carddata fetch-cards"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.3.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.5"
  }
}
