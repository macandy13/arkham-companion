{
  "name": "arkham-companion",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @arkham/web dev",
    "build": "pnpm --filter @arkham/web build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "pnpm --filter @arkham/web e2e",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p .claude/hooks",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "carddata:fetch": "pnpm --filter @arkham/carddata fetch-cards"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
